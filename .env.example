APP_NAME=AI-Hexing
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8010
WEB_ORIGIN=http://127.0.0.1:3060
DATABASE_URL=sqlite:///./data/ai_hexing.db
DATA_DIR=./data
PROVIDER_MODE=mock
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_REGION=beijing
QWEN_MODEL=qwen3.7-flash
QWEN_ANALYSIS_THINKING=false
QWEN_WRITING_THINKING=false
VOICE_API_KEY=
VOICE_REGION=beijing
VOICE_TARGET_MODEL=cosyvoice-v3.5-flash
VOICE_ENROLLMENT_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
VOICE_SYNTHESIS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
PROVIDER_CONTRACT_VERSION=
LIVE_CALLS_ENABLED=false
ENABLE_VALIDATION_TOOLS=true
EXTERNAL_CALL_TIMEOUT_SECONDS=120
JOB_LEASE_SECONDS=180
JOB_HEARTBEAT_SECONDS=15
SESSION_TTL_SECONDS=28800
# Live voice enrollment requires a privately managed, signed HTTPS sample URL.
# Configure the exact allowed storage host; never expose DATA_DIR publicly.
VOICE_SAMPLE_ALLOWED_HOST=

# 本工作台新增模型调用预算（整数微元，1 元 = 1000000 微元）；修改后重启 API 和 worker
COST_SINGLE_LIMIT_MICROS=1000000
COST_MONTHLY_LIMIT_MICROS=30000000
PUBLIC_EVENT_SOURCE_PER_MINUTE=60
PUBLIC_EVENT_TOTAL_PER_MINUTE=600
PUBLIC_EVENT_RETENTION_DAYS=30
PUBLIC_EVENT_MAX_ROWS=20000
